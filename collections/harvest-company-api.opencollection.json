{
  "opencollection": "1.0.0",
  "info": {
    "name": "Harvest API v2 Clients Company API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Company",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve company settings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.harvestapp.com/v2/company"
          },
          "docs": "Retrieve company settings"
        },
        {
          "info": {
            "name": "Update company settings",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.harvestapp.com/v2/company"
          },
          "docs": "Update company settings"
        }
      ]
    }
  ],
  "bundled": true
}