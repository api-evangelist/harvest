{
  "opencollection": "1.0.0",
  "info": {
    "name": "Harvest API v2 Clients Estimates API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Estimates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List estimates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.harvestapp.com/v2/estimates"
          },
          "docs": "List estimates"
        },
        {
          "info": {
            "name": "Create an estimate",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.harvestapp.com/v2/estimates"
          },
          "docs": "Create an estimate"
        },
        {
          "info": {
            "name": "Retrieve an estimate",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.harvestapp.com/v2/estimates/:estimate_id",
            "params": [
              {
                "name": "estimate_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Retrieve an estimate"
        },
        {
          "info": {
            "name": "Update an estimate",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://api.harvestapp.com/v2/estimates/:estimate_id",
            "params": [
              {
                "name": "estimate_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Update an estimate"
        },
        {
          "info": {
            "name": "Delete an estimate",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.harvestapp.com/v2/estimates/:estimate_id",
            "params": [
              {
                "name": "estimate_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Delete an estimate"
        }
      ]
    }
  ],
  "bundled": true
}