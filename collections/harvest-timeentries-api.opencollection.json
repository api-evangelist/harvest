{
  "opencollection": "1.0.0",
  "info": {
    "name": "Harvest API v2 Clients TimeEntries API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "TimeEntries",
        "type": "folder"
      },
